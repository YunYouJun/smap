{
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "nr -r build",
    "dev": "nr -r dev",
    "lint": "eslint --cache .",
    "prepublishOnly": "nr build",
    "predocs": "typedoc",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm build && pnpm predocs && pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview",
    "app:dev": "pnpm sdk:dev && pnpm smap:dev",
    "app:build": "pnpm sdk:build && pnpm smap:build",
    "app:generate": "pnpm sdk:build && pnpm smap:generate",
    "app:preview": "pnpm smap:preview",
    "app:typecheck": "pnpm sdk:build && pnpm smap:typecheck",
    "sdk:build": "pnpm --filter @yunyoujun/smap-sdk build",
    "sdk:dev": "pnpm --filter @yunyoujun/smap-sdk dev",
    "smap:dev": "pnpm -C apps/smap run dev",
    "smap:build": "pnpm -C apps/smap run build",
    "smap:generate": "pnpm -C apps/smap run generate",
    "smap:preview": "pnpm -C apps/smap run preview",
    "smap:typecheck": "pnpm -C apps/smap run typecheck",
    "release": "bumpp -r && pnpm -r publish",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@antfu/utils": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "pkg-placeholder": "workspace:*",
    "simple-git-hooks": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
